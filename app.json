{
  "expo": {
    "name": "LingoMingle",
    "slug": "lingomingle",
    "scheme": "lingomingle",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EF"
      },
      "package": "com.marcelosofficial.lingomingle"
    }
  }
}
